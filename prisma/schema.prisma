generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Wood {
  honey
  cream
  mint
}

enum HighlightColor {
  pink
  blue
  green
  yellow
}

model User {
  id              String      @id
  name            String
  email           String      @unique
  emailVerified   Boolean     @default(false)
  image           String?
  username        String?     @unique
  displayUsername String?
  avatar          String      @default("cat-0")
  libraryName     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  sessions        Session[]
  accounts        Account[]
  bookcases       Bookcase[]
  books           Book[]
  bookmarks       Bookmark[]
  highlights      Highlight[]
  savedWords      SavedWord[]

  @@map("user")
}

model Bookcase {
  id        String   @id @default(cuid())
  name      String
  wood      Wood     @default(honey)
  position  Int
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  books     Book[]

  @@unique([userId, name])
  @@index([userId, position])
  @@map("bookcase")
}

model Book {
  id           String      @id @default(cuid())
  title        String
  author       String?
  pageCount    Int
  fileSize     Int
  fileKey      String      @unique
  spineColor   String
  position     Int
  lastReadPage Int         @default(0)
  bookcaseId   String
  userId       String
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  bookcase     Bookcase    @relation(fields: [bookcaseId], references: [id], onDelete: Cascade)
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookmarks    Bookmark[]
  highlights   Highlight[]
  savedWords   SavedWord[]

  @@index([bookcaseId, position])
  @@index([userId])
  @@map("book")
}

model Bookmark {
  id        String   @id @default(cuid())
  page      Int
  bookId    String
  userId    String
  createdAt DateTime @default(now())

  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, page])
  @@index([userId])
  @@map("bookmark")
}

model Highlight {
  id        String         @id @default(cuid())
  page      Int
  color     HighlightColor
  text      String
  rects     Json
  note      String?
  bookId    String
  userId    String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  book      Book           @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bookId, page])
  @@index([userId])
  @@map("highlight")
}

model SavedWord {
  id           String   @id @default(cuid())
  word         String
  translation  String
  language     String
  partOfSpeech String?
  definition   String?
  page         Int
  bookId       String
  userId       String
  createdAt    DateTime @default(now())

  book         Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bookId, word])
  @@index([userId])
  @@map("saved_word")
}

model Session {
  id        String   @id
  token     String   @unique
  expiresAt DateTime
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}